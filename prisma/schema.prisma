// Construction Platform — Prisma Schema
//
// IMPORTANT: This is the migration source only.
// All runtime queries inside withTenantContext() use raw pg (PoolClient).
// Prisma is used for: migrations, seeding, non-tenant-scoped queries only.
// See: T-42, T-50, tenant-context/SKILL.md
//
// RLS policies are applied in migration files as raw SQL.
// After generating a migration, add RLS policy SQL before running it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Use direct DATABASE_URL (not PgBouncer) for migrations
  url      = env("DATABASE_URL")
}

// ─── DOMAIN 1: Tenants & Platform ────────────────────────────────────────────

model Tenant {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String   @unique
  tier        TenantTier @default(starter)
  status      TenantStatus @default(trial)
  trialEndsAt DateTime? @map("trial_ends_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  users       User[]
  projects    Project[]

  @@map("tenants")
  @@index([status])
  @@index([deletedAt])
}

enum TenantTier {
  starter
  professional
  business
  enterprise

  @@map("tenant_tier")
}

enum TenantStatus {
  trial
  active
  cancelled
  grace_period
  suspended

  @@map("tenant_status")
}

// ─── DOMAIN 2: Users ─────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  email              String
  passwordHash       String?  @map("password_hash")
  firstName          String   @map("first_name")
  lastName           String   @map("last_name")
  role               UserRole
  languagePreference String   @default("en") @map("language_preference") @db.Char(2)
  phone              String?  @db.Text
  status             UserStatus @default(active)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  createdBy          String?  @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@map("users")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([email])
}

enum UserRole {
  owner
  project_manager
  estimator
  foreman
  field_tech
  accountant
  safety_officer
  client_portal
  sub_portal

  @@map("user_role")
}

enum UserStatus {
  active
  invited
  suspended
  deactivated

  @@map("user_status")
}

// ─── DOMAIN 3: Projects ──────────────────────────────────────────────────────

model Project {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  status      ProjectStatus @default(active)
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  address     String?
  city        String?
  state       String?  @db.Char(2)
  zip         String?
  countyFips  String?  @map("county_fips") @db.Char(5)
  countyName  String?  @map("county_name")
  version     Int      @default(1)  // optimistic locking (T-12)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdBy   String?  @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("projects")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
}

enum ProjectStatus {
  active
  completed
  on_hold
  cancelled

  @@map("project_status")
}

// ─── DOMAIN 4: Cross-Tenant Bridge ───────────────────────────────────────────
// shared_project_events is EXEMPT from standard RLS (T-44, T-45)
// Managed manually in migration SQL — not via Prisma model
// See: cross-tenant-bridge/SKILL.md

// ─── DOMAIN 5: Financials ─────────────────────────────────────────────────────

model Invoice {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String        @map("tenant_id") @db.Uuid
  projectId                String        @map("project_id") @db.Uuid
  amountCents              Int           @map("amount_cents")           // T-02: never float
  status                   InvoiceStatus @default(draft)
  dueDate                  DateTime?     @map("due_date") @db.Date
  contractId               String?       @map("contract_id") @db.Uuid  // FK to contracts
  retainageHeldCents       Int           @default(0) @map("retainage_held_cents")
  retainageReleasedCents   Int           @default(0) @map("retainage_released_cents")
  stripePaymentIntentId    String?       @map("stripe_payment_intent_id")  // set by stripe worker
  quickbooksInvoiceId      String?       @map("quickbooks_invoice_id")     // set by QB worker
  connectionId             String?       @map("connection_id") @db.Uuid    // 0041 — sub-side bridge link (Doc 07 §5.1)
  version                  Int           @default(1)                    // T-12: optimistic locking
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                DateTime?     @map("deleted_at") @db.Timestamptz
  createdBy                String?       @map("created_by") @db.Uuid

  @@map("invoices")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
  @@index([tenantId, updatedAt])
  @@index([tenantId, contractId])
}

enum InvoiceStatus {
  draft
  sent
  paid
  void

  @@map("invoice_status")
}

model ChangeOrder {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  projectId          String            @map("project_id") @db.Uuid
  title              String
  description        String?
  amountCents        Int               @map("amount_cents")
  status             ChangeOrderStatus @default(pending)
  contractId         String?           @map("contract_id") @db.Uuid      // FK to contracts
  scheduleImpactDays Int               @default(0) @map("schedule_impact_days")
  direction          String?           // 'owner_to_gc' | 'gc_to_sub'
  vendorId           String?           @map("vendor_id") @db.Uuid        // FK to vendors
  reasonCode         String?           @map("reason_code")
  connectionId       String?           @map("connection_id") @db.Uuid    // 0033 — bridge link (drift backfill)
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz
  createdBy          String?           @map("created_by") @db.Uuid

  @@map("change_orders")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, updatedAt])
  @@index([tenantId, contractId])
}

enum ChangeOrderStatus {
  pending
  approved
  rejected

  @@map("change_order_status")
}

model BudgetLineItem {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  projectId            String    @map("project_id") @db.Uuid
  costCodeId           String?   @map("cost_code_id") @db.Uuid
  description          String
  budgetCents          Int       @map("budget_cents")
  actualCents          Int       @default(0) @map("actual_cents")    // maintained by field_cost_rollup job
  committedAmountCents Int       @default(0) @map("committed_amount_cents")  // from awarded vendor bid
  projectedFinalCents  Int       @default(0) @map("projected_final_cents")   // from schedule_cost_projection job
  vendorBidId          String?   @map("vendor_bid_id") @db.Uuid      // FK to vendor_bids (set on award)
  contractId           String?   @map("contract_id") @db.Uuid        // FK to contracts
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz
  createdBy            String?   @map("created_by") @db.Uuid

  @@map("budget_line_items")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, updatedAt])
  @@index([tenantId, vendorBidId])
  @@index([tenantId, contractId])
}

model CostCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  category  String?
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdBy String?   @map("created_by") @db.Uuid

  @@unique([tenantId, code])
  @@map("cost_codes")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

// ─── DOMAIN 6: Documents ─────────────────────────────────────────────────────

model Document {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  projectId       String       @map("project_id") @db.Uuid
  docType         DocumentType @map("doc_type")
  title           String
  storagePath     String?      @map("storage_path")  // live storage path — never direct URL (T-05)
  fileSizeBytes   Int?         @map("file_size_bytes")
  status          String?
  version         Int          @default(1)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz
  createdBy       String?      @map("created_by") @db.Uuid

  @@map("documents")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, docType])
  @@index([tenantId, updatedAt])
}

enum DocumentType {
  rfi
  submittal
  plan
  spec
  contract
  report
  other

  @@map("document_type")
}

model Rfi {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  number     Int
  subject    String
  status     String    @default("open")  // open, answered, closed
  dueDate    DateTime? @map("due_date") @db.Date
  assigneeId String?   @map("assignee_id") @db.Uuid
  connectionId String? @map("connection_id") @db.Uuid  // 0032 — bridge link (drift backfill)
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  createdBy  String?   @map("created_by") @db.Uuid

  @@unique([tenantId, projectId, number])
  @@map("rfis")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, updatedAt])
}

model Submittal {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  number      Int
  title       String
  status      String    @default("draft")  // draft, submitted, approved, rejected
  specSection String?   @map("spec_section")
  connectionId String?  @map("connection_id") @db.Uuid  // 0033 — bridge link (drift backfill)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid

  @@unique([tenantId, projectId, number])
  @@map("submittals")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, updatedAt])
}

// ─── DOMAIN 7: Field Operations ───────────────────────────────────────────────

model DailyReport {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  reportDate  DateTime  @map("report_date") @db.Date
  weather     Json?
  notes       String?   // append-only conflict policy (T-13)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid

  @@map("daily_reports")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, updatedAt])
  @@index([tenantId, reportDate])
}

model TimeEntry {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  projectId          String    @map("project_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  date               DateTime  @db.Date
  hoursWorked        Decimal   @map("hours_worked") @db.Decimal(5, 2)
  costCodeId         String?   @map("cost_code_id") @db.Uuid
  notes              String?
  budgetLineItemId   String?   @map("budget_line_item_id") @db.Uuid  // triggers field_cost_rollup job
  hourlyCrateCents   Int?      @map("hourly_rate_cents")             // rate at time of logging (T-02)
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  createdBy          String?   @map("created_by") @db.Uuid

  @@map("time_entries")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, updatedAt])
  @@index([tenantId, userId, date])
  @@index([tenantId, budgetLineItemId])
}

model PunchListItem {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  title       String
  description String?
  status      PunchListStatus @default(open)
  assignedTo  String?         @map("assigned_to") @db.Uuid
  dueDate     DateTime?       @map("due_date") @db.Date
  version     Int             @default(1)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz
  createdBy   String?         @map("created_by") @db.Uuid

  @@map("punch_list_items")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, updatedAt])
  @@index([tenantId, status])
}

enum PunchListStatus {
  open
  in_progress
  complete

  @@map("punch_list_status")
}

model Inspection {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  projectId        String           @map("project_id") @db.Uuid
  title            String
  inspectionDate   DateTime?        @map("inspection_date") @db.Timestamptz
  status           InspectionStatus @default(scheduled)
  notes            String?
  version          Int              @default(1)
  // Added by migration 0009 — permit linkage + AHJ fields (all nullable, backward-compatible)
  permitId         String?          @map("permit_id") @db.Uuid
  tradeType        String?          @map("trade_type")
  inspectionType   String?          @map("inspection_type")
  sequenceOrder    Int?             @map("sequence_order")
  inspectorName    String?          @map("inspector_name")
  correctionNotice String?          @map("correction_notice")
  result           String?          // pass | fail | partial — formal AHJ result; synced to status
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz
  createdBy        String?          @map("created_by") @db.Uuid

  @@map("inspections")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, updatedAt])
}

enum InspectionStatus {
  scheduled
  passed
  failed
  requires_action

  @@map("inspection_status")
}

// ─── DOMAIN 8: Safety ─────────────────────────────────────────────────────────

model SafetyIncident {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  projectId    String           @map("project_id") @db.Uuid
  incidentDate DateTime         @map("incident_date") @db.Timestamptz
  description  String
  severity     IncidentSeverity
  status       IncidentStatus   @default(open)
  version      Int              @default(1)  // T-13 Tier 3: blocks until Safety Officer resolves
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz
  createdBy    String?          @map("created_by") @db.Uuid

  @@map("safety_incidents")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, updatedAt])
  @@index([tenantId, status])
}

enum IncidentSeverity {
  near_miss
  first_aid
  recordable
  lost_time
  fatality

  @@map("incident_severity")
}

enum IncidentStatus {
  open
  under_investigation
  closed

  @@map("incident_status")
}

model JsaRecord {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  title       String
  conductedAt DateTime? @map("conducted_at") @db.Timestamptz
  attendees   Json?
  hazards     Json?
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid

  @@map("jsa_records")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, updatedAt])
}

model SafetyCertification {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  certType     String    @map("cert_type")
  issuedAt     DateTime? @map("issued_at") @db.Date
  expiresAt    DateTime? @map("expires_at") @db.Date
  documentPath String?   @map("document_path")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdBy    String?   @map("created_by") @db.Uuid

  @@map("safety_certifications")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, userId])
}

// ─── DOMAIN 9: Estimating ─────────────────────────────────────────────────────

model BidPackage {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  projectId      String          @map("project_id") @db.Uuid
  title          String
  status         BidPackageStatus @default(draft)
  dueDate        DateTime?       @map("due_date") @db.Date
  scheduleTaskId String?         @map("schedule_task_id") @db.Uuid  // FK to schedule_tasks
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz
  createdBy      String?         @map("created_by") @db.Uuid

  @@map("bid_packages")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, updatedAt])
  @@index([tenantId, scheduleTaskId])
}

enum BidPackageStatus {
  draft
  open
  closed
  awarded

  @@map("bid_package_status")
}

model TakeoffItem {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  projectId    String    @map("project_id") @db.Uuid
  bidPackageId String?   @map("bid_package_id") @db.Uuid
  description  String
  quantity     Decimal   @db.Decimal(10, 3)
  unit         String?
  unitCostCents Int      @default(0) @map("unit_cost_cents")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdBy    String?   @map("created_by") @db.Uuid

  @@map("takeoff_items")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, updatedAt])
}

model Markup {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  name       String
  percentage Decimal   @db.Decimal(5, 2)
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  createdBy  String?   @map("created_by") @db.Uuid

  @@map("markups")
  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

// ─── DOMAIN 9b: Vendors, Contracts, Bids, Schedule ───────────────────────────

enum VendorType {
  subcontractor
  supplier
  equipment
  other

  @@map("vendor_type")
}

model Vendor {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  name             String
  vendorType       VendorType @default(subcontractor) @map("vendor_type")
  tradeType        String?    @map("trade_type")
  contactName      String?    @map("contact_name")
  contactEmail     String?    @map("contact_email")
  contactPhone     String?    @map("contact_phone")
  isPreferred      Boolean    @default(false) @map("is_preferred")
