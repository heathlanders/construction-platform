  @@index([warrantyId])
}

model WarrantyAuditEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  warrantyId  String    @map("warranty_id") @db.Uuid
  claimId     String?   @map("claim_id") @db.Uuid
  eventType   String    @map("event_type")
  actorId     String?   @map("actor_id") @db.Uuid
  actorType   String    @default("staff") @map("actor_type") // staff|homeowner|system
  description String
  payload     Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("warranty_audit_events")
  @@index([tenantId])
  @@index([warrantyId])
  @@index([claimId])
}

// ─── DOMAIN 16: Codes Reference Store (no RLS — platform reference data) ──────
// National jurisdiction/codes engine storage (migration 0020, Doc 16).
// Not tenant-scoped — exempt from RLS like Tenant / TenantSubscription.

model CodeEdition {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trade        String   // electrical|plumbing|mechanical|building
  stateCode    String   @map("state_code") @db.Char(2)
  codeType     String   @map("code_type") // NEC|IPC|UPC|IMC|UMC|IRC|IBC
  codeEdition  String?  @map("code_edition")
  necEdition   String?  @map("nec_edition") // electrical only
  notes        String?
  source       String?
  lastVerified DateTime? @map("last_verified") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("code_editions")
  @@unique([trade, stateCode])
  @@index([stateCode])
}

model ZipCounty {
  zip         String   @db.Char(5)
  countyFips  String   @map("county_fips") @db.Char(5)
  countyName  String   @map("county_name")
  stateCode   String   @map("state_code") @db.Char(2)
  primaryCity String?  @map("primary_city")
  ratio       Decimal? @db.Decimal

  @@id([zip, countyFips])
  @@map("zip_county")
  @@index([zip])
}

model County {
  countyFips String @id @map("county_fips") @db.Char(5)
  countyName String @map("county_name")
  stateCode  String @map("state_code") @db.Char(2)

  @@map("counties")
  @@index([stateCode])
}

model JurisdictionLayer {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  level        String    // state|county|city
  stateCode    String?   @map("state_code") @db.Char(2)
  countyFips   String?   @map("county_fips") @db.Char(5)
  countyName   String?   @map("county_name")
  cityName     String?   @map("city_name")
  ahj          Json?
  codes        Json?
  notes        String?
  source       String?
  lastVerified DateTime? @map("last_verified") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("jurisdiction_layers")
  @@index([stateCode, countyFips, cityName])
}
