{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --require dotenv/config src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "backfill:project-names": "tsx --require dotenv/config src/scripts/backfill-project-names.ts",
    "seed:code-editions": "tsx --require dotenv/config src/scripts/seed-code-editions.ts",
    "seed:jurisdiction-layers": "tsx --require dotenv/config src/scripts/seed-jurisdiction-layers.ts",
    "seed:zip-county": "tsx --require dotenv/config src/scripts/seed-zip-county.ts",
    "seed:codes-reference": "npm run seed:code-editions -- --apply && npm run seed:jurisdiction-layers -- --apply && npm run seed:zip-county -- --apply",
    "import:zip-county": "tsx --require dotenv/config src/scripts/import-zip-county.ts",
    "import:county-centroids": "tsx --require dotenv/config src/scripts/import-county-centroids.ts",
    "backfill:project-geocode": "tsx --require dotenv/config src/scripts/backfill-project-geocode.ts",
    "pack:new": "tsx src/scripts/pack-new.ts",
    "pack:barrel": "tsx src/scripts/pack-barrel.ts",
    "pack:check": "tsx src/scripts/pack-check.ts",
    "pack:smoke": "tsx src/scripts/pack-smoke.ts",
    "pack:verify-sources": "tsx src/scripts/pack-verify-sources.ts",
    "gen:catalog-migration": "tsx src/scripts/gen-catalog-migration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-sqs": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@prisma/client": "^5.10.0",
    "@sentry/node": "^10.45.0",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.26.0",
    "ioredis": "^5.3.0",
    "jsonwebtoken": "^9.0.0",
    "mupdf": "^1.27.0",
    "pdfjs-dist": "^4.7.76",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.0",
    "pg-boss": "^9.0.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "dotenv": "^17.3.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}
