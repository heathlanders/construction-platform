[Unit]
# Local Ollama model server — powers the blueprint vision augmentation
# (Qwen2.5-VL 7B; see docs/Blueprint_Intelligence_v1_0.md §Vision Augmentation).
# Install as a USER service so it needs no root and survives reboot when the
# user has lingering enabled (`loginctl enable-linger $USER`).
#
#   cp scripts/ollama.service ~/.config/systemd/user/ollama.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now ollama
#   systemctl --user status ollama
#
# The api container reaches it via host.docker.internal:11434 (docker-compose
# extra_hosts). Driver < 550 → Ollama uses the Vulkan backend on the GTX 1070
# (still full-GPU, ~38-40s/sheet warm); a driver upgrade unlocks CUDA (faster).
Description=Ollama local model server (blueprint vision)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/user/.local/ollama/bin/ollama serve
Environment=OLLAMA_HOST=0.0.0.0:11434
Environment=OLLAMA_KEEP_ALIVE=10m
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
