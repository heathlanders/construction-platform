{
  "expo": {
    "name": "The Jobsite",
    "slug": "thejobsite",
    "scheme": "thejobsite",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "splash": {
      "backgroundColor": "#1e3a5f",
      "resizeMode": "contain"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/00000000-0000-0000-0000-000000000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thejobsite.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos for daily reports, punch list items, and asset damage reports",
        "NSPhotoLibraryUsageDescription": "Attach photos from your library to damage reports and inspections",
        "NSLocationWhenInUseUsageDescription": "Show your location on project site maps",
        "NSLocationAlwaysUsageDescription": "Track location during active field work"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e3a5f"
      },
      "package": "com.thejobsite.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-camera",
      "expo-image-picker",
      "expo-location",
      "expo-updates",
      "@morrowdigital/watermelondb-expo-plugin"
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
